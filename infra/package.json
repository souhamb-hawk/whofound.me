{
  "name": "@whofound/infra",
  "version": "0.1.0",
  "private": true,
  "description": "whofound.me AWS CDK infrastructure",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "cdk": "cdk",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all",
    "deploy:cert": "cdk deploy WhofoundmeCertificateStack",
    "deploy:main": "cdk deploy WhofoundmeStack",
    "destroy": "cdk destroy --all",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist cdk.out"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.120.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "aws-cdk": "^2.120.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

